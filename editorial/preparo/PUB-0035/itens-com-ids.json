    {
      "id": "Q-TI-ES-005-17",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "A ordem clássica do TDD é:",
      "options": [
        {
          "id": "A",
          "text": "green, red, deploy"
        },
        {
          "id": "B",
          "text": "refactor, deploy, red"
        },
        {
          "id": "C",
          "text": "red, green, refactor"
        },
        {
          "id": "D",
          "text": "unit, system, accept"
        },
        {
          "id": "E",
          "text": "code, document, ignore"

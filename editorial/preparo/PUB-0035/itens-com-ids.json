        },
        {
          "id": "B",
          "text": "medir CPU"
        },
        {
          "id": "C",
          "text": "compilar código"
        },
        {
          "id": "D",
          "text": "desenhar UML"
        },
        {
          "id": "E",
          "text": "calcular cobertura"
        }

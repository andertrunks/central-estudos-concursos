  "training": [
    {
      "id": "T-TI-ES-005-01",
      "text": "explique erro, defeito e falha com um exemplo próprio."
    },
    {
      "id": "T-TI-ES-005-02",
      "text": "classifique como estático ou dinâmico:\n- revisão;\n- análise estática;\n- teste unitário;\n- carga;\n- integração."
    },
    {
      "id": "T-TI-ES-005-03",
      "text": "crie um requisito com três partições de equivalência."
    },
    {
      "id": "T-TI-ES-005-04",
      "text": "gere seis valores-limite para esse requisito."
    },
    {
      "id": "T-TI-ES-005-05",
      "text": "crie tabela de decisão com duas condições booleanas."
    },
    {
      "id": "T-TI-ES-005-06",
      "text": "escreva um if simples e defina testes para cobrir os dois ramos."
    },
    {
      "id": "T-TI-ES-005-07",
      "text": "explique por que 100% de instruções não garante 100% de ramos."
    },
    {
      "id": "T-TI-ES-005-08",
      "text": "descreva um stub para dependência externa."
    },
    {
      "id": "T-TI-ES-005-09",
      "text": "descreva uma interação que seria verificada com mock."
    },
    {
      "id": "T-TI-ES-005-10",
      "text": "classifique três testes como unitário, integração ou sistema."
    },
    {
      "id": "T-TI-ES-005-11",
      "text": "dê exemplo de reteste e de regressão após mesma correção."
    },
    {
      "id": "T-TI-ES-005-12",
      "text": "crie cenário de carga e cenário de estresse."
    },
    {
      "id": "T-TI-ES-005-13",
      "text": "simule três ciclos red-green-refactor."
    },
    {
      "id": "T-TI-ES-005-14",
      "text": "explique quando usar JUnit e quando Mockito complementa JUnit."
    },
    {
      "id": "T-TI-ES-005-15",
      "text": "resolva as 20 questões sem consulta."
    }
  ]

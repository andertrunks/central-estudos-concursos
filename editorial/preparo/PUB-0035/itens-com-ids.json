{
  "questions": [
    {
      "id": "Q-TI-ES-005-01",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "A manifestação observável de comportamento incorreto durante a execução é denominada:",
      "options": [
        {
          "id": "A",
          "text": "requisito"
        },
        {
          "id": "B",
          "text": "falha"
        },
        {
          "id": "C",
          "text": "revisão"
        },
        {
          "id": "D",
          "text": "cobertura"
        },
        {
          "id": "E",
          "text": "fixture"
        }
      ],
      "answer": "B",
      "comment": "Falha é a manifestação observável incorreta durante execução."
    },
    {
      "id": "Q-TI-ES-005-02",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Constitui atividade estática:",
      "options": [
        {
          "id": "A",
          "text": "teste de carga"
        },
        {
          "id": "B",
          "text": "teste unitário"
        },
        {
          "id": "C",
          "text": "revisão de código"
        },
        {
          "id": "D",
          "text": "teste de integração"
        },
        {
          "id": "E",
          "text": "teste funcional executado"
        }
      ],
      "answer": "C",
      "comment": "Revisão ocorre sem executar o software testado, sendo atividade estática."
    },
    {
      "id": "Q-TI-ES-005-03",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "O teste unitário tem como foco principal:",
      "options": [
        {
          "id": "A",
          "text": "todo o ambiente organizacional"
        },
        {
          "id": "B",
          "text": "pequena unidade de comportamento, preferencialmente isolada"
        },
        {
          "id": "C",
          "text": "somente infraestrutura de rede"
        },
        {
          "id": "D",
          "text": "aprovação contratual final"
        },
        {
          "id": "E",
          "text": "auditoria financeira"
        }
      ],
      "answer": "B",
      "comment": "Unitário concentra-se em unidade pequena e controlada."
    },
    {
      "id": "Q-TI-ES-005-04",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "O teste de integração busca principalmente:",
      "options": [
        {
          "id": "A",
          "text": "medir apenas cobertura de instruções"
        },
        {
          "id": "B",
          "text": "verificar interação entre componentes"
        },
        {
          "id": "C",
          "text": "revisar requisitos sem executar software"
        },
        {
          "id": "D",
          "text": "substituir aceitação"
        },
        {
          "id": "E",
          "text": "eliminar a necessidade de teste unitário"
        }
      ],
      "answer": "B",
      "comment": "Integração verifica interfaces e colaboração entre componentes."
    },
    {
      "id": "Q-TI-ES-005-05",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Assinale a associação correta:",
      "options": [
        {
          "id": "A",
          "text": "funcional — nível exclusivamente unitário"
        },
        {
          "id": "B",
          "text": "integração — tipo de requisito não funcional"
        },
        {
          "id": "C",
          "text": "sistema — avaliação da solução integrada"
        },
        {
          "id": "D",
          "text": "aceitação — análise estática"
        },
        {
          "id": "E",
          "text": "caixa-branca — ignora estrutura interna"
        }
      ],
      "answer": "C",
      "comment": "Teste de sistema avalia o sistema integrado. As demais associações confundem nível, tipo ou técnica."
    },
    {
      "id": "Q-TI-ES-005-06",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Reteste e regressão diferem porque:",
      "options": [
        {
          "id": "A",
          "text": "reteste confirma correção específica; regressão busca efeitos colaterais"
        },
        {
          "id": "B",
          "text": "regressão confirma apenas o defeito corrigido"
        },
        {
          "id": "C",
          "text": "são sinônimos"
        },
        {
          "id": "D",
          "text": "reteste nunca executa software"
        },
        {
          "id": "E",
          "text": "regressão é exclusivamente revisão"
        }
      ],
      "answer": "A",
      "comment": "Reteste confirma correção; regressão procura impactos colaterais."
    },
    {
      "id": "Q-TI-ES-005-07",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Uma técnica de caixa-preta adequada para dividir um intervalo de entradas em classes representativas é:",
      "options": [
        {
          "id": "A",
          "text": "cobertura de ramos"
        },
        {
          "id": "B",
          "text": "particionamento de equivalência"
        },
        {
          "id": "C",
          "text": "análise estática"
        },
        {
          "id": "D",
          "text": "cobertura de instruções"
        },
        {
          "id": "E",
          "text": "instrumentação"
        }
      ],
      "answer": "B",
      "comment": "Particionamento divide o domínio em classes representativas."
    },
    {
      "id": "Q-TI-ES-005-08",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Para uma regra que aceita valores de 18 a 65, qual conjunto enfatiza fronteiras?",
      "options": [
        {
          "id": "A",
          "text": "30, 40, 50"
        },
        {
          "id": "B",
          "text": "17, 18, 19, 64, 65, 66"
        },
        {
          "id": "C",
          "text": "1, 2, 3"
        },
        {
          "id": "D",
          "text": "18 apenas"
        },
        {
          "id": "E",
          "text": "65 apenas"
        }
      ],
      "answer": "B",
      "comment": "Os valores imediatamente abaixo, nos limites, imediatamente acima e vizinhanças pressionam fronteiras."
    },
    {
      "id": "Q-TI-ES-005-09",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "A cobertura de ramos busca verificar:",
      "options": [
        {
          "id": "A",
          "text": "somente linhas comentadas"
        },
        {
          "id": "B",
          "text": "resultados possíveis de decisões"
        },
        {
          "id": "C",
          "text": "satisfação do usuário"
        },
        {
          "id": "D",
          "text": "documentação de requisitos"
        },
        {
          "id": "E",
          "text": "número de mocks"
        }
      ],
      "answer": "B",
      "comment": "Cobertura de ramos avalia alternativas de decisão exercitadas."
    },
    {
      "id": "Q-TI-ES-005-10",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Uma suíte alcançou 100% de cobertura de instruções. É correto concluir que:",
      "options": [
        {
          "id": "A",
          "text": "o software não possui defeitos"
        },
        {
          "id": "B",
          "text": "todos os requisitos foram necessariamente testados"
        },
        {
          "id": "C",
          "text": "todas as instruções mensuradas foram exercitadas, mas isso não garante correção completa"
        },
        {
          "id": "D",
          "text": "todos os ramos foram exercitados"
        },
        {
          "id": "E",
          "text": "todo teste possui boas assertivas"
        }
      ],
      "answer": "C",
      "comment": "100% de instruções significa execução completa segundo esse critério, não correção total nem cobertura de todos os ramos/requisitos."
    },
    {
      "id": "Q-TI-ES-005-11",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "O teste de carga busca principalmente:",
      "options": [
        {
          "id": "A",
          "text": "revisar código sem execução"
        },
        {
          "id": "B",
          "text": "avaliar comportamento sob volume esperado/modelado"
        },
        {
          "id": "C",
          "text": "verificar somente sintaxe"
        },
        {
          "id": "D",
          "text": "substituir teste funcional"
        },
        {
          "id": "E",
          "text": "eliminar gargalos automaticamente"
        }
      ],
      "answer": "B",
      "comment": "Carga mede comportamento sob volume esperado ou modelado."
    },
    {
      "id": "Q-TI-ES-005-12",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "O teste de estresse diferencia-se do de carga por:",
      "options": [
        {
          "id": "A",
          "text": "nunca executar o sistema"
        },
        {
          "id": "B",
          "text": "pressionar o sistema além de condições normais ou limites esperados"
        },
        {
          "id": "C",
          "text": "ser exclusivamente unitário"
        },
        {
          "id": "D",
          "text": "usar apenas mocks"
        },
        {
          "id": "E",
          "text": "não medir desempenho"
        }
      ],
      "answer": "B",
      "comment": "Estresse pressiona além do normal para observar degradação, limite e recuperação."
    },
    {
      "id": "Q-TI-ES-005-13",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Um stub é utilizado tipicamente para:",
      "options": [
        {
          "id": "A",

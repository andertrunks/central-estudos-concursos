      "answer": "A",
      "comment": "Stub fornece respostas predeterminadas."
    },
    {
      "id": "Q-TI-ES-005-14",
      "contentId": "TI-ES-005",
      "origin": "inédita",
      "statement": "Um mock é particularmente útil para:",
      "options": [
        {
          "id": "A",
